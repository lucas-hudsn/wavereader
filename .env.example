# Copy to .env and fill in. Never commit .env.
# HF token for the HF Router (Nemotron) — https://huggingface.co/settings/tokens
HF_TOKEN=
# Model override (default: nvidia/NVIDIA-Nemotron-3.5-Lightning-30B-A3B-BF16)
WR_MODEL=
# Inference provider override (default: fireworks-ai)
WR_PROVIDER=
# Base URL override for a local OpenAI-compatible endpoint (e.g. Ollama/NIM)
WR_BASE_URL=
