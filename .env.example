# Copy to .env and fill in. Never commit .env.
# HF token for the HF Router (Nemotron) — https://huggingface.co/settings/tokens
HF_TOKEN=
# Model override (default: nvidia/NVIDIA-Nemotron-3-Ultra-550B-A55B-BF16)
WR_MODEL=
# Inference provider override (default: deepinfra)
WR_PROVIDER=
# Base URL override for a local OpenAI-compatible endpoint (e.g. Ollama/NIM)
WR_BASE_URL=
